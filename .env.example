# Variables de Entorno - EuropaBot

## Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

## WhatsApp Business API
WHATSAPP_API_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-verify-token
WHATSAPP_APP_SECRET=your-app-secret

## WhatsApp Flow de cita (prueba, opcional)
# flow_id que entrega WhatsApp Manager al publicar scratchpad/appointment-flow.json
WHATSAPP_APPOINTMENT_FLOW_ID=
# 'whatsapp_flow' manda el formulario nativo en vez de la maquina de estados por texto.
# Vacio o cualquier otro valor = comportamiento actual, sin cambios.
APPOINTMENT_FLOW_MODE=

## Cron Jobs (Vercel)
CRON_SECRET=your-secure-random-string

# Nota: CRON_SECRET debe ser una cadena aleatoria segura
# Ejemplo: openssl rand -base64 32
# Esta variable protege los endpoints de cron jobs en produccion
# WHATSAPP_APP_SECRET es obligatorio en produccion para validar firmas de Meta
